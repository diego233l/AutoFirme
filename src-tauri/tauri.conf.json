{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoFirma Web",
  "mainBinaryName": "AutoFirmaWeb",
  "version": "0.1.0",
  "identifier": "es.administracionabierta.autofirmaweb",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoFirma Web",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Productivity",
    "shortDescription": "Firma electrónica sin servidores",
    "longDescription": "Firma y verifica documentos con certificados X.509 (CAdES, XAdES, PAdES). Las claves privadas nunca salen de tu equipo.",
    "copyright": "GPL-2.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
